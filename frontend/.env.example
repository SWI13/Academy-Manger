# Frontend environment. Copy to .env.local for host development.
# Never commit .env.local - it is gitignored.

# Where Next reaches Django. Not public: the browser never uses this value.
# Host development:   http://localhost:8000
# Inside Docker:      http://backend:8000
DJANGO_INTERNAL_URL=http://localhost:8000

# This app's own public address. Used for the Origin and Referer headers the
# BFF sends to Django, which its CSRF check compares against
# CSRF_TRUSTED_ORIGINS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
