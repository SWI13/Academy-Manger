# ---------------------------------------------------------------------------
# SM Academy - production environment template
#
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod. It is gitignored; keep the real values in whatever
# the institute uses for secrets, and write down where. The backup script
# deliberately does not include this file - secrets do not belong in a tarball
# beside the data they protect.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# 64 bytes of randomness, and not the one from the development file:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false

# The public hostname, plus localhost. Not "*". Django checks the forwarded
# host against this list, which is what keeps USE_X_FORWARDED_HOST safe.
#
# `localhost` is here for the container's own healthcheck, which calls
# 127.0.0.1 and would otherwise be rejected as DisallowedHost - leaving the
# container permanently unhealthy. It is reachable only from inside the
# container's own network namespace, so allowing it grants nothing.
DJANGO_ALLOWED_HOSTS=academy.example.com,localhost

# --- Database -------------------------------------------------------------
# Postgres publishes no port in the production stack. This host is the compose
# service name and is reachable only on the internal network.
POSTGRES_DB=sm_academy
POSTGRES_USER=sm_academy
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
# db0 cache, db1 Celery broker, db2 Celery results, db3 sessions.
# Sessions are separate on purpose: clearing the cache must not sign the whole
# institute out mid-transaction.
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_URL=redis://redis:6379/3
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage -------------------------------------------------------
# Two endpoints, and they are not interchangeable. Django reaches the store on
# the internal network; the browser follows a presigned URL, which is signed
# over the host it names and so cannot be rewritten afterwards.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://academy.example.com/storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO's own names for the two values above. Keep them identical - they are
# the same credentials; MinIO calls its root user what S3 calls an access key.
# Spelled out here so the compose file needs no variable substitution, which
# is what silently mixes development and production values.
#
# MinIO refuses to start if the user is under 3 characters or the password
# under 8, and says so only in its own logs - the stack then fails with
# "dependency failed to start" and no obvious cause.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET_NAME=sm-academy-private
S3_REGION=us-east-1
S3_UPLOAD_URL_TTL=300
S3_DOWNLOAD_URL_TTL=60

# --- Frontend -------------------------------------------------------------
# https, matching the certificate. This is what the BFF sends as the forwarded
# host and origin, and what Django's CSRF check compares against.
PUBLIC_SITE_URL=https://academy.example.com

# --- Runtime --------------------------------------------------------------
# Rule of thumb: (2 x cores) + 1. Three is right for a small VPS.
GUNICORN_WORKERS=3

# Nights kept in backups/ before pruning. The script does not copy them off
# this machine - that step belongs to whoever owns the server.
BACKUP_KEEP_DAYS=30

# --- Locale ---------------------------------------------------------------
DEFAULT_PHONE_REGION=DZ
