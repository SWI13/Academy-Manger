# ---------------------------------------------------------------------------
# SM Academy - environment template
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-before-running-anything
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database -------------------------------------------------------------
# Host is the compose service name. Use localhost when running outside Docker.
POSTGRES_DB=sm_academy
POSTGRES_USER=sm_academy
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
# DB 0 = cache + sessions, DB 1 = Celery broker, DB 2 = Celery results.
REDIS_URL=redis://redis:6379/0
# Sessions live on their own database so that clearing the general cache
# is not a mass logout. db1 and db2 belong to Celery.
REDIS_SESSION_URL=redis://redis:6379/3
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, S3-compatible in production) ----------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_NAME=sm-academy-private
S3_REGION=us-east-1
# Seconds a presigned upload/download URL stays valid.
S3_UPLOAD_URL_TTL=300
S3_DOWNLOAD_URL_TTL=60

# --- Frontend -------------------------------------------------------------
# Internal address of the Django API. The browser never sees this.
INTERNAL_API_URL=http://backend:8000
# Public origin of the Next.js app, used for CORS and cookie domain.
PUBLIC_SITE_URL=http://localhost:3000

# --- Money ----------------------------------------------------------------
DEFAULT_CURRENCY=DZD
